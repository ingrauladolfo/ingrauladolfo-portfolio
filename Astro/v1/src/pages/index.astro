---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/sections/index/SectionContainer.astro";
import Experience from "@/sections/Experience/Experience.astro";
import Projects from "@/sections/Projects/Projects.astro";
import AboutMe from "@/sections/AboutMe/AboutMe.astro";
import Hero from "@/sections/Hero/Hero.astro";
import ProfileCheck from "@/assets/icons/sections/index/ProfileCheck.astro";
import Briefcase from "@/assets/icons/Briefcase.astro";
import CodeIcon from "@/assets/icons/sections/Projects/CodeIcon.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Stack from "@/sections/Stack/Stack.astro";
type tLang = (str: any) => any;
const lang = getLangFromUrl(Astro.url);
const t: tLang = useTranslations(lang);
---

<Layout title={t("layout.title")} description={t("layout.description")}>
  <main>
    <SectionContainer class="py-44 pb-32">
      <Hero />
    </SectionContainer>

    <SectionContainer id="experiencia">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-8 text-black/80 dark:text-white"
      >
        <Briefcase class="size-7" />
        {t("exp.title")}
      </h2>
      <Experience />
    </SectionContainer>

    <SectionContainer id="proyectos">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-8 text-black/80 dark:text-white"
      >
        <CodeIcon class="size-7" />
        {t("projects.title")}
      </h2>
      <Projects />
    </SectionContainer>
    <SectionContainer id="stack">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-8 text-black/80 dark:text-white"
      >
        <CodeIcon class="size-7" />
        {t("stack.title")}
      </h2>
      <Stack />
    </SectionContainer>
    <SectionContainer id="sobre-mi">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-8 text-black/80 dark:text-white"
      >
        <ProfileCheck class="size-8" />
        {t("about.title")}
      </h2>
      <AboutMe />
    </SectionContainer>
  </main>
</Layout>
